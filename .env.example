# Copy to .env and fill in. Never commit a real key.
# Port the server listens on (hosts inject their own PORT; Render/Railway/Fly do this automatically).
PORT=3000

# Your SportsGameOdds API key. Takes precedence over any key saved through the
# app's Settings UI. Get one at https://sportsgameodds.com/
SPORTSGAMEODDS_KEY=

# Your The Odds API key (https://the-odds-api.com — free tier, 500 requests/month).
# When set, the odds board uses The Odds API instead of SportsGameOdds
# (1 request per refresh). Also takes precedence over Settings-saved keys.
ODDS_API_KEY=

# Where the SQLite database lives. Keep ./data on a persistent volume in Docker.
DB_PATH=./data/app.db

# Where the drizzle migration SQL files live (relative to the server workdir).
MIGRATIONS_DIR=./drizzle

# Where the built React client lives (relative to the server workdir).
CLIENT_DIR=./client/dist

# Base URL of this deployment, used by scripts/refresh.js.
APP_URL=http://localhost:3000

# Admin token for the sharing lockdown. When set, provider key save/remove and
# manual sportsbook refreshes require this token. Set it before sharing the link.
ADMIN_TOKEN=
